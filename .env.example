# Copy to .env (which is gitignored) and fill in. NEVER commit real values.
# This repo is PUBLIC — a committed key is compromised within minutes.

# --- LLM (agent) — Groq free tier ---
GROQ_API_KEY=
# gpt-oss-20b: reliable tool-calling + own token budget (70b's 100K/day
# gets shared/exhausted across apps). Override if you hit limits.
GROQ_MODEL=openai/gpt-oss-20b

# --- Database + Auth ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server/runner only, NEVER client-exposed

# --- Email alerts (Resend free tier) ---
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.dev

# --- Web Push (VAPID keypair; generate with web-push) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:singh.ashutosh@gmail.com

# --- SMS (optional, opt-in per watch) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Cron auth (fail-closed: executor refuses to run if unset) ---
CRON_SHARED_SECRET=
